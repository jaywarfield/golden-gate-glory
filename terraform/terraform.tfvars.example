# terraform/terraform.tfvars.example
# Mission Veteran AI
#
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real credentials.
#
#   cp terraform/terraform.tfvars.example terraform/terraform.tfvars

ibmcloud_api_key          = "YOUR_IBM_CLOUD_API_KEY"
region                    = "us-south"         # us-south | eu-de | eu-gb | jp-tok | au-syd
resource_group_name       = "Default"          # your resource group name
orchestrate_instance_name = "mission-veteran-ai"
plan                      = "essentials"       # essentials | standard (ignored when existing_watsonx_orchestrate_instance_crn is set)
resource_tags             = ["project:mission-veteran-ai", "env:dev"]

# Hackathon / trial accounts: set this to your existing instance CRN instead of provisioning a new one.
# Retrieve from: IBM Cloud console → Resource list → watsonx Orchestrate → CRN
# existing_watsonx_orchestrate_instance_crn = "crn:v1:bluemix:public:watsonx-orchestrate:us-south:..."

# watsonx Governance
governance_instance_name  = "mission-veteran-ai-governance"
governance_plan           = "lite"             # lite | standard
