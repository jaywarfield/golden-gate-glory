# .dockerignore
# Exclude files not needed inside the bridge server container.

.git/
.github/
.vscode/
.bob/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.DS_Store

# Development / docs not needed at runtime
notebooks/
data/
docs/
tests/
terraform/
governance/
logs/

# Orchestrate deployment artifacts (not needed at runtime)
agents/
connections/
models/
tools/
workspace_config.yaml

# Local env file — credentials are passed as env vars at runtime
.env
.env.*
