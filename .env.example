# .env.example
# Mission Veteran AI — environment variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored — never commit real credentials.

# ── watsonx.ai ──────────────────────────────────────────────────────────────
# IBM Cloud API key (IAM) — create at cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=

# watsonx.ai endpoint — default works for us-south; change for other regions
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# watsonx.ai project ID — copy from your project settings in watsonx.ai
WATSONX_PROJECT_ID=

# ── watsonx Governance ───────────────────────────────────────────────────────
# Resource list → AI/Machine Learning → <your Governance instance> → GUID
GOVERNANCE_INSTANCE_GUID=

# ── Bridge server (optional overrides) ──────────────────────────────────────
# Comma-separated list of allowed CORS origins for the bridge server.
# Default (*) allows all; narrow this to your GitHub Pages URL in production:
#   ALLOWED_ORIGINS=https://<your-github-username>.github.io
ALLOWED_ORIGINS=*
